# Copy to `.env` in the repo root (see root `.gitignore` — `.env` is not committed).
# Use your machine's LAN IP so a phone on the same Wi‑Fi can reach a host‑bound backend.
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://localhost:8000
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
# When the Expo web origin is not localhost (e.g. LAN IP), set backend `HARMONIQ_CORS_ORIGINS`
# in `backend/.env` to match, e.g. http://192.168.1.42:8081

EXPO_PUBLIC_API_URL=http://localhost:8000
# Commit 72: skip all client TTS (voice coach) — CI / headless.
EXPO_PUBLIC_HARMONIQ_SKIP_TTS=

ANTHROPIC_API_KEY=your_real_key_here

