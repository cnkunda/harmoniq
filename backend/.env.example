# ── Phase 2: MLOps Environment Variables ──

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Observability
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Job config
HARMONIQ_JOB_TTL_HOURS=24
HARMONIQ_MAX_CONCURRENT_JOBS=4

# Drift detection
HARMONIQ_DRIFT_BASELINE=models/drift_baseline.npy

# Model server
CHORD_MODEL_PATH=models/chord_model.tflite
HARMONIQ_TFLITE_FLEX=0

# Force in-memory mode (when Redis is unavailable)
HARMONIQ_USE_REDIS=auto
