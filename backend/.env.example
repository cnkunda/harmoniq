# Copy to `.env` and fill secrets locally (`.env` is gitignored).

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
LYRIA_MODEL=lyria-realtime-exp
PIPELINE_VERSION=1
# Style hints for coach: unset or 0 = BPM bucket label + technique_hints; 1 = force style_label "general" and no hints.
HARMONIQ_SKIP_STYLE_DETECT=
DATA_DIR=./data
