# Copy to `.env` and fill secrets locally (`.env` is gitignored).

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
LYRIA_MODEL=lyria-realtime-exp
PIPELINE_VERSION=1
# Style hints for coach: unset or 0 = BPM bucket label + technique_hints; 1 = force style_label "general" and no hints.
HARMONIQ_SKIP_STYLE_DETECT=
# AlphaTab Node prerender (PRIORITIES §59): default off — set ENABLE=1 locally after `npm install` in `backend/`.
HARMONIQ_ENABLE_PRERENDER=
# CI / fast paths: skip prerender even when ENABLE is set.
HARMONIQ_SKIP_PRERENDER=
# Client (Expo): EXPO_PUBLIC_HARMONIQ_SKIP_SKILL_MUTATION=1 skips commit 63 technique EMA after Review.
HARMONIQ_SKIP_SKILL_MUTATION=
# Skip curriculum ranking API (commit 65) for CI/offline fast paths.
HARMONIQ_SKIP_CURRICULUM=
# Practice plan (commit 70): 1 = template coach intros only (no Claude batch call).
HARMONIQ_SKIP_PRACTICE_PLAN=
# Coach timeout in milliseconds (commit 66 default = 8000).
HARMONIQ_COACH_TIMEOUT_MS=8000
DATA_DIR=./data
# Optional comma-separated browser origins for Expo web / LAN dev (merged with localhost defaults).
# Example: HARMONIQ_CORS_ORIGINS=http://192.168.1.42:8081
HARMONIQ_CORS_ORIGINS=
# Spotify OAuth + taste (PRIORITIES §67). CI: set HARMONIQ_SKIP_SPOTIFY=1.
HARMONIQ_SKIP_SPOTIFY=
SPOTIFY_CLIENT_ID=
# Must match a redirect URI in the Spotify Developer Dashboard.
HARMONIQ_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
# After OAuth, web clients return here (Expo web dev server).
HARMONIQ_SPOTIFY_WEB_RETURN=http://127.0.0.1:8081
# Deep link scheme segment for native post-login redirect (default harmoniq).
HARMONIQ_SPOTIFY_APP_SCHEME=harmoniq
# Skip POST /taste/derive (commit 68) for CI/offline.
HARMONIQ_SKIP_TASTE_DERIVE=
