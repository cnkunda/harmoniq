# Backend local configuration. Copy to `backend/.env` and edit.
# Full variable reference (defaults, required flags, owner areas): ../docs/CONFIGURATION.md
#
# NOTE: `backend/.env` is loaded by `app.main` when uvicorn imports the app.
# The Celery worker does NOT import app.main, so export these variables in the
# worker shell (or use Docker Compose) when running a worker.

# ---- Core ----
DATA_DIR=./data
# Extra browser origins for Expo web / LAN dev (merged with localhost defaults).
# Example: HARMONIQ_CORS_ORIGINS=http://192.168.1.42:8081
HARMONIQ_CORS_ORIGINS=

# ---- Database / Redis / Celery ----
# Used when running outside Docker for local development.
DATABASE_URL_SYNC=postgresql+psycopg2://harmoniq:harmoniq_dev@localhost:5432/harmoniq
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Local dev: 1 = run analysis/recompute jobs in-process instead of dispatching
# to Celery (no worker required; GET /analyze and SSE see in-process updates).
HARMONIQ_SKIP_CELERY=

# ---- Local ML fast paths ----
# CPU dev: 1 = skip the MT3 tier and go straight to CRNN/chroma fallback
# (MT3 inference takes tens of minutes per song on CPU).
HARMONIQ_SKIP_MT3=
# 1 = use htdemucs_ft (faster, lower quality) instead of htdemucs_6s.
HARMONIQ_FAST_STEMS=
# 1 = skip stem separation entirely (developer/CI only).
HARMONIQ_SKIP_DEMUCS=
HARMONIQ_SKIP_STEMS=

# ---- Coach / LLM (optional) ----
# Missing or rejected keys degrade coach/enrichment to "skipped", not failure.
ANTHROPIC_API_KEY=
# HARMONIQ_MODEL_ID=claude-haiku-4-5-20251001
# HARMONIQ_COACH_TIMEOUT_MS=8000
# HARMONIQ_SKIP_CHORD_ENRICHMENT=
# HARMONIQ_SKIP_MENTOR=
# HARMONIQ_MENTOR_TIMEOUT_MS=20000
# HARMONIQ_SKIP_PRACTICE_PLAN=
# HARMONIQ_SKIP_CURRICULUM=
# HARMONIQ_SKIP_STYLE_DETECT=
# HARMONIQ_SKIP_LYRIA_CLIP=
# HARMONIQ_SKIP_THEORY_ANNOTATE=

# ---- Spotify + taste (optional) ----
# CI: set HARMONIQ_SKIP_SPOTIFY=1.
HARMONIQ_SKIP_SPOTIFY=
HARMONIQ_SKIP_SPOTIFY_PLAYBACK=
HARMONIQ_SKIP_TASTE_DERIVE=
SPOTIFY_CLIENT_ID=
# Must match a redirect URI in the Spotify Developer Dashboard.
HARMONIQ_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
# After OAuth, web clients return here (Expo web dev server).
HARMONIQ_SPOTIFY_WEB_RETURN=http://127.0.0.1:8081
# Deep link scheme segment for native post-login redirect (default harmoniq).
HARMONIQ_SPOTIFY_APP_SCHEME=harmoniq

# ---- Jam backing providers (optional) ----
# Ordered chain; unavailable providers are skipped quickly. Default:
# ace_step_modal,lyria,mrt2,bundled (synth is always appended as last resort).
# HARMONIQ_BACKING_PROVIDERS=ace_step_modal,lyria,mrt2,bundled
# Per-attempt deadline (seconds) for each provider.
# HARMONIQ_BACKING_TIMEOUT_S=45
# Warm cloud endpoints (POST JSON -> audio/wav or {"audio_base64": ...}).
# HARMONIQ_ACE_STEP_BACKING_URL=
# HARMONIQ_MODAL_TOKEN=
# HARMONIQ_LYRIA_BACKING_URL=
# GEMINI_API_KEY=

# ---- Tablature assignment ----
# 1 = keep pitch-only solo notes (no persisted string/fret).
HARMONIQ_SKIP_TAB_ASSIGNMENT=
# dp (playability-aware) or baseline (allCellsForMidi-equivalent).
HARMONIQ_TAB_ASSIGNMENT_MODE=dp
# Tuning name from app.fretting.tuning (standard, drop_d, half_step_down, ...).
HARMONIQ_TAB_TUNING=standard
# stub (default) or none.
# HARMONIQ_TAB_CATALOG=stub

# ---- AlphaTab Node prerender ----
# Default off; set ENABLE=1 locally after `npm install` in `backend/`.
HARMONIQ_ENABLE_PRERENDER=
# CI / fast paths: skip prerender even when ENABLE is set.
HARMONIQ_SKIP_PRERENDER=

# ---- Operator / DLQ hardening (optional) ----
# Operator token for DLQ endpoints (loopback allowed when unset).
# HARMONIQ_OPERATOR_TOKEN=
# HARMONIQ_ALLOW_REMOTE_OPERATOR=0
# HARMONIQ_DLQ_MAX_ENTRIES=1000

# ---- Test-only (never set in production) ----
# HARMONIQ_ENABLE_COACH_IN_TESTS=
# HARMONIQ_ENABLE_ENRICHMENT_IN_TESTS=

# ---- Deprecated / ignored ----
# DATABASE_URL is not read by the app (only DATABASE_URL_SYNC).
# PIPELINE_VERSION is a code constant, not an env var.
# LYRIA_MODEL, GEMINI_API_BASE, MINIMAX_API_KEY, HARMONIQ_ENRICHMENT_MODEL are unused.
