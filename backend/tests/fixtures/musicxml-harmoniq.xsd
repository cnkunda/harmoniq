<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal MusicXML XSD subset for Harmoniq CI validation.
  Covers all elements generated by musicxml_builder.py.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="score-partwise">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="work" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="work-title" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="movement-title" type="xs:string" minOccurs="0"/>
        <xs:element name="identification" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="creator" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="type" type="xs:string"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="encoding" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="encoding-date" type="xs:string" minOccurs="0"/>
                    <xs:element name="software" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="defaults" minOccurs="0"/>
        <xs:element ref="part-list"/>
        <xs:element ref="part" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="defaults">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="scaling" minOccurs="0"/>
        <xs:element ref="page-layout" minOccurs="0"/>
        <xs:element ref="system-layout" minOccurs="0"/>
        <xs:element ref="staff-layout" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="scaling">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="millimeters" type="xs:decimal"/>
        <xs:element name="tenths" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="page-layout">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="page-height" type="xs:decimal" minOccurs="0"/>
        <xs:element name="page-width" type="xs:decimal" minOccurs="0"/>
        <xs:element name="page-margins" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="left-margin" type="xs:decimal"/>
              <xs:element name="right-margin" type="xs:decimal"/>
              <xs:element name="top-margin" type="xs:decimal"/>
              <xs:element name="bottom-margin" type="xs:decimal"/>
            </xs:sequence>
            <xs:attribute name="type" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="system-layout">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="system-margins" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="left-margin" type="xs:decimal"/>
              <xs:element name="right-margin" type="xs:decimal"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="system-distance" type="xs:decimal" minOccurs="0"/>
        <xs:element name="top-system-distance" type="xs:decimal" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="staff-layout">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="staff-distance" type="xs:decimal" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="part-list">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="score-part" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="score-part">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="part-name" type="xs:string"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="part">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="measure" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="measure">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="attributes"/>
          <xs:element ref="note"/>
          <xs:element ref="forward"/>
          <xs:element ref="backup"/>
          <xs:element ref="harmony"/>
          <xs:element ref="frame"/>
          <xs:element ref="direction"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="number" type="xs:string"/>
      <xs:attribute name="implicit" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="forward">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="duration" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="backup">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="duration" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="attributes">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="divisions" type="xs:decimal" minOccurs="0"/>
        <xs:element ref="key" minOccurs="0"/>
        <xs:element ref="time" minOccurs="0"/>
        <xs:element name="staves" type="xs:decimal" minOccurs="0"/>
        <xs:element name="clef" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sign" type="xs:string"/>
              <xs:element name="line" type="xs:decimal" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="key">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fifths" type="xs:decimal"/>
        <xs:element name="mode" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="time">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="beats" type="xs:string"/>
        <xs:element name="beat-type" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="note">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="pitch" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="step" type="xs:string"/>
              <xs:element name="alter" type="xs:decimal" minOccurs="0"/>
              <xs:element name="octave" type="xs:decimal"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="rest" minOccurs="0">
          <xs:complexType><xs:sequence/></xs:complexType>
        </xs:element>
        <xs:element name="duration" type="xs:decimal"/>
        <xs:element name="tie" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="type" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="voice" type="xs:decimal" minOccurs="0"/>
        <xs:element name="type" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="1024th"/>
              <xs:enumeration value="512th"/>
              <xs:enumeration value="256th"/>
              <xs:enumeration value="128th"/>
              <xs:enumeration value="64th"/>
              <xs:enumeration value="32nd"/>
              <xs:enumeration value="16th"/>
              <xs:enumeration value="eighth"/>
              <xs:enumeration value="quarter"/>
              <xs:enumeration value="half"/>
              <xs:enumeration value="whole"/>
              <xs:enumeration value="breve"/>
              <xs:enumeration value="long"/>
              <xs:enumeration value="max"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="dot" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:sequence/></xs:complexType>
        </xs:element>
        <xs:element name="beam" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="number" type="xs:decimal" use="required"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="notations" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="tied">
                  <xs:complexType>
                    <xs:attribute name="type" type="xs:string" use="required"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="slur">
                  <xs:complexType>
                    <xs:attribute name="type" type="xs:string" use="required"/>
                    <xs:attribute name="number" type="xs:decimal"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="technical">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="string" type="xs:decimal" minOccurs="0"/>
                      <xs:element name="fret" type="xs:decimal" minOccurs="0"/>
                      <xs:element name="fingering" type="xs:string" minOccurs="0"/>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="articulations">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:choice minOccurs="0" maxOccurs="unbounded">
                        <xs:element name="staccato"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        <xs:element name="accent"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        <xs:element name="tenuto"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                      </xs:choice>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="dynamics">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:choice minOccurs="0" maxOccurs="unbounded">
                        <xs:element name="pp"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        <xs:element name="p"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        <xs:element name="mp"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        <xs:element name="mf"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        <xs:element name="f"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        <xs:element name="ff"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                      </xs:choice>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="dynamics" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="pp"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                <xs:element name="p"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                <xs:element name="mp"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                <xs:element name="mf"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                <xs:element name="f"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                <xs:element name="ff"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="lyric" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="text" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="dynamics" type="xs:decimal"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="harmony">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="root" minOccurs="0"/>
        <xs:element name="root-alter" minOccurs="0">
          <xs:complexType><xs:sequence><xs:element name="alter" type="xs:decimal"/></xs:sequence></xs:complexType>
        </xs:element>
        <xs:element name="kind" minOccurs="0">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="text" type="xs:string"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="root-step" type="xs:string"/>
        <xs:element name="root-alter" type="xs:decimal" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="frame">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="frame-strings" type="xs:decimal"/>
        <xs:element name="frame-frets" type="xs:decimal"/>
        <xs:element name="frame-note" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="string" type="xs:decimal"/>
              <xs:choice minOccurs="0">
                <xs:element name="fret" type="xs:decimal"/>
                <xs:element name="mute" type="xs:string"/>
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="direction">
    <xs:complexType>
      <xs:sequence>
        <xs:choice>
          <xs:element name="direction-type">
            <xs:complexType>
              <xs:sequence>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                  <xs:element name="metronome">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:choice>
                          <xs:element name="beat-unit" type="xs:string"/>
                          <xs:element name="beat-unit-dot"><xs:complexType><xs:sequence/></xs:complexType></xs:element>
                        </xs:choice>
                        <xs:element name="per-minute" type="xs:decimal" minOccurs="0"/>
                      </xs:sequence>
                      <xs:attribute name="parentheses" type="xs:string"/>
                    </xs:complexType>
                  </xs:element>
                </xs:choice>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
        <xs:element name="sound" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="tempo" type="xs:decimal"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="offset" type="xs:decimal" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
