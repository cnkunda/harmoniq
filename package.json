{
  "name": "harmoniq",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test --config=playwright.config.ts --grep-invert @visual",
    "test:visual": "playwright test --config=playwright.config.ts --grep @visual",
    "test:visual:update": "playwright test --config=playwright.config.ts --grep @visual --update-snapshots",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "test:mobile": "detox test --configuration android.emu.debug --take-screenshots all",
    "test:mobile:android": "detox test --configuration android.emu.debug --take-screenshots all",
    "test:mobile:ios": "detox test --configuration ios.sim.debug --take-screenshots all",
    "audit:inventory": "node scripts/audit/generate-inventory.mjs",
    "audit:platform": "node scripts/audit/generate-platform-audit.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "^55.0.15",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sharing": "^55.0.17",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react": "^0.544.0",
    "lucide-react-native": "^0.544.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-audio-api": "^0.11.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.1.0",
    "detox": "^20.50.1",
    "jest": "^30.3.0",
    "jest-circus": "^30.3.0",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.1.3"
  }
}
